{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Study pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "vocabulary",
    "questions"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "vocabulary": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "word",
          "meaning"
        ],
        "properties": {
          "word": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "meaning": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "prompt",
          "options",
          "answer"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,64}$"
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "passage": {
            "type": "string",
            "maxLength": 20000
          },
          "options": {
            "type": "array",
            "minItems": 2,
            "maxItems": 8,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "answer": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7
          }
        }
      }
    }
  }
}
